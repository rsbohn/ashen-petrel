020012 000045      DUP             ; (b a a)
020013 051403      STOR DB+403     ; (b a)
020014 000032      XCH             ; (a b)
020015 041403      LOAD DB+403     ; (a b a)
020016 041402      LOAD DB+402     ; (a b a rho)
020017 032000      SXIT 0

021000  ORG 21000
